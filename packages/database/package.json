{
  "name": "@sitecare/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "@sitecare/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "6.8.2",
    "@types/node": "22.15.18",
    "typescript": "5.8.3",
    "vitest": "3.2.2"
  }
}
