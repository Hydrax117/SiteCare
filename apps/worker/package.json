{
  "name": "@sitecare/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@sitecare/billing": "workspace:*",
    "@sitecare/database": "workspace:*",
    "@sitecare/email": "workspace:*",
    "@sitecare/monitoring": "workspace:*",
    "@sitecare/queue": "workspace:*",
    "@sitecare/security": "workspace:*",
    "@sitecare/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.15.18",
    "typescript": "5.8.3",
    "vitest": "3.2.2"
  }
}
