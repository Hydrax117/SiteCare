# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
DATABASE_URL="postgresql://sitecare:password@localhost:5432/sitecare_dev"

# -----------------------------------------------------------------------
# Web app
# -----------------------------------------------------------------------
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-character-secret"

# -----------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------
EMAIL_FROM="SiteCare <noreply@example.com>"
EMAIL_SERVER_URL="smtp://user:password@smtp.example.com:587"


